# Cloud Aegis Backend — deploy/docker variant
# This file exists for deploy/docker/ convention.
# The canonical Dockerfile is at the repository root.
#
# Diverges from root Dockerfile in:
#   - Config copied to /app/configs/config.yaml (root uses /app/config.example.yaml)
#   - User shell: /sbin/nologin (root uses /bin/sh)
#
# Usage:
#   docker build -f deploy/docker/Dockerfile.backend -t aegis-api .
#
# Or use the root Dockerfile directly:
#   docker build -t aegis-api .

# Re-use root Dockerfile via build context
FROM golang:1.25-alpine AS builder

ARG VERSION=dev

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /aegis \
    ./cmd/server

FROM alpine:3.20

RUN addgroup -g 1000 aegis && \
    adduser -u 1000 -G aegis -s /sbin/nologin -D aegis

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /aegis /app/aegis
COPY --from=builder /app/frontend/src/lib/mock /app/frontend/src/lib/mock
COPY configs/config.example.yaml /app/configs/config.yaml

RUN chown -R aegis:aegis /app

USER aegis

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/aegis"]
