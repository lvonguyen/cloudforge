{
  "catalogs": [
    {
      "name": "aegis_pg",
      "type": "postgresql",
      "jdbc": {
        "jdbcUri": "jdbc:postgresql://${PG_HOST}:${PG_PORT}/${PG_DATABASE}",
        "username": "${PG_USER}",
        "password": "${PG_PASSWORD}"
      }
    }
  ],
  "vertices": [
    {
      "label": "finding",
      "oneOf": [
        {
          "tableName": "findings",
          "catalog": "aegis_pg",
          "schema": "public",
          "mappings": {
            "id": { "column": "id", "type": "string" },
            "title": { "column": "title", "type": "string" },
            "severity": { "column": "severity", "type": "string" },
            "category": { "column": "category", "type": "string" },
            "cloud_provider": { "column": "cloud_provider", "type": "string" },
            "status": { "column": "status", "type": "string" },
            "resource_id": { "column": "resource_id", "type": "string" },
            "account_id": { "column": "account_id", "type": "string" },
            "service_name": { "column": "service_name", "type": "string" }
          }
        }
      ]
    },
    {
      "label": "resource",
      "oneOf": [
        {
          "tableName": "resources",
          "catalog": "aegis_pg",
          "schema": "public",
          "mappings": {
            "id": { "column": "id", "type": "string" },
            "name": { "column": "name", "type": "string" },
            "type": { "column": "resource_type", "type": "string" },
            "region": { "column": "region", "type": "string" },
            "account_id": { "column": "account_id", "type": "string" },
            "cloud_provider": { "column": "cloud_provider", "type": "string" }
          }
        }
      ]
    },
    {
      "label": "compliance_framework",
      "oneOf": [
        {
          "tableName": "compliance_frameworks",
          "catalog": "aegis_pg",
          "schema": "public",
          "mappings": {
            "id": { "column": "id", "type": "string" },
            "name": { "column": "name", "type": "string" },
            "version": { "column": "version", "type": "string" },
            "category": { "column": "category", "type": "string" },
            "score": { "column": "score", "type": "double" }
          }
        }
      ]
    }
  ],
  "edges": [
    {
      "label": "affects",
      "from": "finding",
      "to": "resource",
      "oneOf": [
        {
          "tableName": "findings",
          "catalog": "aegis_pg",
          "schema": "public",
          "mappings": {
            "from": { "column": "id" },
            "to": { "column": "resource_id" }
          }
        }
      ]
    },
    {
      "label": "maps_to",
      "from": "finding",
      "to": "compliance_framework",
      "oneOf": [
        {
          "tableName": "compliance_mappings",
          "catalog": "aegis_pg",
          "schema": "public",
          "mappings": {
            "from": { "column": "finding_id" },
            "to": { "column": "framework_id" }
          }
        }
      ]
    }
  ]
}
