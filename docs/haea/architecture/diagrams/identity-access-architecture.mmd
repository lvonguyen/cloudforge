flowchart TB
    %% ═══════════════════════════════════════════
    %% IDENTITY ACCESS ARCHITECTURE — CURRENT STATE
    %% HAEA Multi-Cloud Identity Provisioning
    %% Updated Feb 2026: Azure 51 subs, GCP 96 projects
    %% Styled: Georgia font, CSP icons, clean palette
    %% Render: mmdc -i this.mmd -o out.svg --configFile mmdc-config.json
    %% ═══════════════════════════════════════════

    %% ──── SOURCE OF TRUTH ────
    AD["<img src='data:image/svg+xml;base64,' width='26' height='26' /><br/><b>Active Directory</b><br/><i>On-Premises Corporate Directory</i><br/>autoeveramerica.com | hmausa.com"]

    subgraph ENTRA["Microsoft Entra ID — HMGNA Tenant (Source of Truth)"]
        AAD["<img src='data:image/svg+xml;base64,' width='26' height='26' /><br/><b>Entra ID</b><br/><i>formerly Azure AD</i>"]
        subgraph GRPCLASS[" "]
            ADSYNC["AD-Synced Groups<br/><i>On-prem origin, hybrid identity</i>"]
            CLOUDONLY["Cloud-Only Groups<br/><i>Entra ID native, no AD object</i>"]
        end
        AAD --> ADSYNC
        AAD --> CLOUDONLY
    end

    AD -->|"Azure AD Connect<br/>Hybrid Sync<br/>(password hash + objects)"| AAD

    %% ──── AWS — 4 Organizations / 132 Accounts ────
    subgraph AWS["AWS — 4 Organizations / 132 Accounts"]
        subgraph AWSFED["Entra ID → AWS Federation"]
            SAML["SAML 2.0<br/><i>Authentication channel</i><br/>User login via SSO portal"]
            SCIM["SCIM 2.0<br/><i>Provisioning channel</i><br/>Background user/group sync"]
        end
        AWSIS["<img src='data:image/svg+xml;base64,' width='26' height='26' /><br/><b>AWS Identity Store</b><br/><i>IAM Identity Center (us-west-2)</i>"]
        AWSSSO["AWS SSO<br/><i>99 groups / 37 permission sets</i>"]
        SAMLPROV["SAML Provider per account<br/><i>AWSSSO_*_DO_NOT_DELETE</i><br/>Auto-created by Identity Center"]

        subgraph AWSORGS["AWS Organizations"]
            HMGNALEG["HMGNA Legacy<br/>56 accounts<br/><i>Mgmt: 254170812053</i><br/><i>Migrating to HMGNA</i>"]
            HKNA["HKNA<br/>35 accounts"]
            KNA["KNA<br/>21 accounts"]
            HMGNA["HMGNA<br/>20 accounts<br/><i>Successor — HAEA, Glovis</i>"]
        end

        SCIM --> AWSIS
        SAML --> AWSIS
        AWSIS --> AWSSSO
        AWSSSO -->|"Group → Permission Set<br/>→ Account mapping"| AWSORGS
        AWSSSO -.->|"Creates SAML provider<br/>in each member account"| SAMLPROV
    end

    %% ──── AZURE — HMGNA Tenant / 51 Subscriptions ────
    subgraph AZ["Azure — HMGNA Tenant / 51 Subscriptions"]
        ESM["<b>HAEA ESM Portal</b><br/><i>Access request submission</i>"]
        APPROVE["Manager Approval<br/>+ Fulfiller Review"]
        AZRBAC["<img src='data:image/svg+xml;base64,' width='22' height='22' /> <b>Azure RBAC</b><br/><i>Built-in + custom roles</i>"]

        subgraph AZSUBS["51 Subscriptions — 7 CBUs"]
            AZKUS["KUS<br/><i>Kia US</i><br/>22 subs"]
            AZHAEA["HAEA<br/><i>Hyundai AutoEver America</i><br/>14 subs"]
            AZHMA["HMA<br/><i>Hyundai Motor America</i><br/>6 subs"]
            AZOTHER["GUS (3) · KIA (2)<br/>HATCI (1) · SS (3)"]
        end

        ESM --> APPROVE
        APPROVE -->|"Approved"| AZRBAC
        AZRBAC -->|"Scope: Subscription<br/>Resource Group / Resource"| AZSUBS
    end

    %% ──── GCP — 96 Projects / 5 CBUs ────
    subgraph GC["GCP — 96 Projects / 5 CBUs"]
        GCPREQ["ESM Ticket<br/><i>Justification + approval + role requested</i>"]
        GCPADM["GCP Admin<br/><i>Manual user/group provisioning</i>"]
        GCI["<img src='data:image/svg+xml;base64,' width='26' height='26' /><br/><b>Google Cloud Identity</b><br/><i>19 groups / 116 users</i>"]
        GCPIAM["GCP IAM Bindings<br/><i>Role → principal mapping</i>"]

        subgraph GCPHIER["Resource Hierarchy — autoeveramerica.com"]
            GCPORG["Organization"]
            GCPHMA["HMA<br/><i>Hyundai Motor America</i><br/>49 projects"]
            GCPKUS["KUS<br/><i>Kia US</i><br/>21 projects"]
            GCPHAEA["HAEA<br/><i>Hyundai AutoEver America</i><br/>19 projects"]
            GCPMISC["CMN (4) · SBX (3)"]
            GCPORG --> GCPHMA
            GCPORG --> GCPKUS
            GCPORG --> GCPHAEA
            GCPORG --> GCPMISC
        end

        GCPREQ --> GCPADM
        GCPADM -->|"Create user or<br/>map requesting group"| GCI
        GCI --> GCPIAM
        GCPIAM -->|"Org / Folder /<br/>Project scope"| GCPHIER
    end

    %% ──── IDENTITY FLOW CONNECTIONS ────
    ADSYNC -->|"AAD group<br/>membership"| SCIM
    CLOUDONLY -->|"AAD group<br/>membership"| SCIM
    ADSYNC -->|"User auth<br/>(SAML assertion)"| SAML
    CLOUDONLY -->|"User auth<br/>(SAML assertion)"| SAML
    ADSYNC -->|"Group membership<br/>determines eligibility"| ESM
    CLOUDONLY -->|"Group membership<br/>determines eligibility"| ESM
    ADSYNC -->|"Requesting group"| GCPREQ
    CLOUDONLY -->|"Requesting group"| GCPREQ

    %% ──── STYLES ────
    %% Clean palette: white backgrounds, thin colored borders, no heavy fills
    classDef onprem fill:#fff,stroke:#6b7280,stroke-width:2px,color:#1f2937,font-weight:bold
    classDef identity fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a,font-weight:bold
    classDef grpbox fill:#f8fafc,stroke:#cbd5e1,color:#475569
    classDef aws fill:#fff,stroke:#d97706,stroke-width:2px,color:#1f2937,font-weight:bold
    classDef awslegacy fill:#fff,stroke:#d97706,stroke-width:2px,color:#92400e,stroke-dasharray:5 5
    classDef azure fill:#fff,stroke:#2563eb,stroke-width:2px,color:#1f2937,font-weight:bold
    classDef gcp fill:#fff,stroke:#4285f4,stroke-width:2px,color:#1f2937,font-weight:bold

    class AD onprem
    class AAD,ADSYNC,CLOUDONLY identity
    class GRPCLASS grpbox
    class SAML,SCIM,AWSIS,AWSSSO,SAMLPROV,HMGNA,HKNA,KNA aws
    class HMGNALEG awslegacy
    class ESM,APPROVE,AZRBAC,AZKUS,AZHAEA,AZHMA,AZOTHER azure
    class GCPREQ,GCPADM,GCI,GCPIAM,GCPORG,GCPHMA,GCPKUS,GCPHAEA,GCPMISC gcp
