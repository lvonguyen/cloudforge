flowchart LR
    A(["fa:fa-terminal plan-with-policy.sh"]) --> S1

    S1["fa:fa-download Step 1\nterraform init\n-backend=false"]
    S1 --> S2

    S2["fa:fa-search Step 2\nterraform plan\n-var cloud_provider=PROVIDER\n-out=plan.tfplan"]
    S2 --> S3

    S3["fa:fa-file-code Step 3\nterraform show -json\nplan.tfplan > plan.json"]
    S3 --> GATE

    subgraph GATE [OPA Policy Gate]
        direction TB
        CT["fa:fa-shield-alt Step 4\nconftest test plan.json\n--policy policies/\n--namespace terraform"]
        CT --> EXIT{Exit Code}
        EXIT -->|0 — all passed| ALLOW["fa:fa-check-circle Allow Apply"]
        EXIT -->|2 — warnings| WARN["fa:fa-exclamation-triangle Human Review\nRequired"]
        EXIT -->|1 — violations| BLOCK["fa:fa-ban Apply Blocked\nFix violations"]
    end

    ALLOW --> S5
    WARN --> S5
    BLOCK --> FIX(["fa:fa-wrench Fix Rego\nViolations"])
    FIX --> S2

    S5["fa:fa-rocket Step 5\nterraform apply\nplan.tfplan"]
    S5 --> DONE(["fa:fa-check Deploy Complete"])

    subgraph POLICIES [Representative Rego Policy Bundles]
        direction TB
        P1["fa:fa-lock security-baseline.rego\nEncryption, public IP, TLS, IAM wildcard checks"]
        P2["fa:fa-network-wired network-isolation.rego\nSensitive ingress, DB privacy, internal-only OPA"]
        P3["fa:fa-dollar-sign cost-guardrails.rego\nApproved sizes, storage caps, required tags"]
        P4["fa:fa-tag naming-convention.rego\nProject / env / service naming rules"]
        P5["fa:fa-robot ai-governance.rego\nApproved AI models and required observability"]
    end

    CT -.->|evaluates| POLICIES

    style GATE fill:#1e40af,color:#fff
    style ALLOW fill:#22c55e,color:#fff
    style BLOCK fill:#ef4444,color:#fff
    style WARN fill:#f59e0b,color:#000
    style DONE fill:#22c55e,color:#fff
    style POLICIES fill:#374151,color:#fff
