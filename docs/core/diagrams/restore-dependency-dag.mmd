flowchart TD
    START(["fa:fa-play DR Event Declared"]) --> PG

    PG["fa:fa-database 1. PostgreSQL PITR\nRestore from snapshot or replica\nVerify row counts + FK constraints"]

    PG --> REDIS["fa:fa-memory 2. Redis Cache Warming\nPre-warm policy cache (top 100 tenants)\nPre-warm tenant config cache\nTarget: > 80% hit rate in 15 min"]

    PG --> OPA["fa:fa-file-code 3. OPA Policy Restore\nPull from Git remote\nBuild + sign bundle (SHA-256)\nUpload to distribution bucket\nForce sidecar poll"]

    REDIS --> K8S
    OPA --> K8S

    K8S["fa:fa-cubes 4. Kubernetes State (Velero)\nRestore latest successful backup\nVerify all pods running\nPVCs bound, ConfigMaps present"]

    K8S --> TEMPORAL["fa:fa-clock 5. Temporal Recovery\nRestore underlying DB (step 1)\nVerify server health\nResume stuck workflows from checkpoint\nRestart workers"]

    TEMPORAL --> SECRETS["fa:fa-key 6. Secret Rotation\nAll secrets considered compromised\nRotation order:\n  a. Database passwords\n  b. External API keys\n  c. Internal service tokens\n  d. Customer-facing keys (notify)"]

    SECRETS --> DNS["fa:fa-globe 7. DNS Cutover\nTTL pre-lowered to 30s\nUPSERT CNAME → DR LB\nVerify propagation (< 60s)\nRestore TTL to 300s when stable"]

    DNS --> DONE(["fa:fa-check-circle DR Restore Complete\nAll services healthy"])

    %% Critical path annotation
    PG -.->|"critical path\n(all depend on DB)"| DONE

    %% Parallel paths
    classDef dbNode     fill:#1e40af,color:#fff,stroke:#1e3a8a,stroke-width:2px
    classDef cacheNode  fill:#f59e0b,color:#000,stroke:#b45309
    classDef policyNode fill:#7c3aed,color:#fff,stroke:#5b21b6
    classDef k8sNode    fill:#3b82f6,color:#fff,stroke:#1d4ed8
    classDef workNode   fill:#06b6d4,color:#fff,stroke:#0e7490
    classDef secNode    fill:#ef4444,color:#fff,stroke:#991b1b
    classDef dnsNode    fill:#22c55e,color:#fff,stroke:#166534
    classDef startEnd   fill:#374151,color:#fff

    class PG dbNode
    class REDIS cacheNode
    class OPA policyNode
    class K8S k8sNode
    class TEMPORAL workNode
    class SECRETS secNode
    class DNS dnsNode
    class START,DONE startEnd
