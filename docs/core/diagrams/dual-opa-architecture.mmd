flowchart LR
    %% dual-opa-architecture.mmd
    %% Cloud Aegis operates two OPA integration paths:
    %%   LEFT  — HTTP REST path: policy.Evaluator sends JSON to an external OPA server
    %%            over HTTP POST /v1/data/aegis/provisioning|exception (30 s timeout).
    %%   RIGHT — Embedded path: ai-governance/opa.Engine runs OPA in-process via the
    %%            OPA Go SDK (no network hop). Evaluates Rego namespace aegis.ai.*
    %%   BOTTOM — Both paths load policies from the shared Rego bundle.

    %% ── Cloud Provisioning Path (Blue) ────────────────────────────────────────
    subgraph PROV["Cloud Provisioning Path"]
        direction TB
        CP["fa:fa-cloud Cloud Provisioning\nRequest\n(PolicyInput)"]
        EVL["fa:fa-cog policy.Evaluator\ninternal/policy/evaluator.go\nHTTP client · 30 s timeout"]
        OPA_SRV["fa:fa-server OPA Server\nPOST /v1/data/aegis/\nprovisioning · exception"]
        PD["fa:fa-check-circle Policy Decision\nPolicyResult\nallow · deny · warn"]
        TF["fa:fa-cogs Terraform / Cloud APIs\nAWS · Azure · GCP\nResource provisioned or blocked"]
    end

    %% ── AI Governance Path (Purple) ──────────────────────────────────────────
    subgraph AI["AI Governance Path"]
        direction TB
        AR["fa:fa-robot AI Agent Request\n(EvaluationInput)\nagent · tool · data · request"]
        ENG["fa:fa-microchip ai-governance/opa.Engine\ninternal/ai-governance/opa/engine.go\nOPA Go SDK · PreparedEvalQuery · sync.RWMutex"]
        INPROC["fa:fa-bolt In-Process Evaluation\ndata.aegis.ai.*\ntool_access · data_flow\nno network hop"]
        DEC["fa:fa-shield-alt Agent Decision\nDecision\nallow · reasons · violations · eval_time_us"]
        REG["fa:fa-list-alt Agent Registry\nallow tool / block tool\nredact PII · rate-limit\nenforce data-flow policy"]
    end

    %% ── Shared Policy Store (Green) ──────────────────────────────────────────
    subgraph STORE["Shared Rego Policy Bundle"]
        direction LR
        PROV_POL["fa:fa-file-code aegis.provisioning\naegis.exception\n(cloud resource rules)"]
        AI_POL["fa:fa-file-code aegis.ai.tool_access\naegis.ai.data_flow\n(agent security rules)"]
    end

    %% ── Provisioning flow ────────────────────────────────────────────────────
    CP  -->|"POST JSON\napplication · resource · region\ntags · requested_by"| EVL
    EVL -->|"HTTP POST\n/v1/data/aegis/provisioning"| OPA_SRV
    OPA_SRV -->|"OPAResponse\nallow · deny[] · warn[]"| PD
    PD  -->|"allowed=true\nproceed"| TF

    %% ── AI governance flow ───────────────────────────────────────────────────
    AR  -->|"AgentContext\nToolContext / DataContext"| ENG
    ENG -->|"pq.Eval(ctx, input)\nin-process"| INPROC
    INPROC -->|"Decision struct\nresult map"| DEC
    DEC -->|"allow=true\ntool invoked"| REG

    %% ── Policy bundle feeds both paths ───────────────────────────────────────
    PROV_POL -->|"loaded by\nOPA server"| OPA_SRV
    AI_POL   -->|"LoadPolicies()\nLoadPolicyBundle()"| ENG

    %% ── Styling ──────────────────────────────────────────────────────────────
    classDef provBlue  fill:#3b82f6,color:#fff,stroke:#1d4ed8,stroke-width:1px
    classDef opaServer fill:#1e40af,color:#fff,stroke:#1e3a8a,stroke-width:2px
    classDef aiPurple  fill:#7c3aed,color:#fff,stroke:#5b21b6,stroke-width:1px
    classDef shared    fill:#22c55e,color:#fff,stroke:#15803d,stroke-width:1px
    classDef subBg     fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#1e293b

    class CP,EVL,PD,TF provBlue
    class OPA_SRV opaServer
    class AR,ENG,INPROC,DEC,REG aiPurple
    class PROV_POL,AI_POL shared
