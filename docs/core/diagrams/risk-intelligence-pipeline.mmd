flowchart TD
    A(["fa:fa-exclamation-triangle Finding Input"]) --> L1

    subgraph L1 ["Layer 1: Parallel Context Enrichment"]
        direction LR
        B1["fa:fa-bug EPSS v4\nExploitation Probability"]
        B2["fa:fa-shield-alt CISA KEV\nKnown Exploited CVEs"]
        B3["fa:fa-layer-group Environment Classifier\nTier1-Prod vs sandbox"]
        B4["fa:fa-code Package Reachability\nIs vulnerable code executed?"]
        B5["fa:fa-user-lock IAM Scope\nBlast radius via role chaining"]
        B6["fa:fa-network-wired GreyNoise\nIP Intelligence"]
        B7["fa:fa-user-secret HIBP\nBreach Lookup"]
        B8["fa:fa-satellite-dish OTX + ThreatFox\nIOC Matching"]
    end

    L1 --> L2

    subgraph L2 ["Layer 2: Pattern Matching"]
        direction LR
        C1["fa:fa-exclamation-circle Toxic Combination Detection\nMulti-finding chain analysis"]
        C2["fa:fa-project-diagram Meta-Pattern Engine\nKnown toxic combos"]
        C3["fa:fa-bullseye Chokepoint Identification\nHigh-centrality graph nodes"]
    end

    L2 --> L3

    subgraph L3 ["Layer 3: Adjudication"]
        direction TB
        D1{Confidence\nThreshold}
        D2["fa:fa-robot Auto-Adjust Severity\nLLM scoring with guardrails"]
        D3["fa:fa-user Human Review Queue\nConf below threshold"]
        D4{Guardrail\nChecks}
        D5["fa:fa-ban GR-001: CRITICAL + Tier1-Prod\nhard floor -- never downgrade"]
        D6["fa:fa-lock GR-002: PCI/PII\nmin severity = MEDIUM"]
        D7["fa:fa-question-circle GR-003: Unknown package usage\ncap confidence at 0.70"]
        D8["fa:fa-sliders-h GR-004: Severity / score alignment\nclamp score to severity band"]
        D1 -->|conf >= 0.70| D2
        D1 -->|conf < 0.70| D3
        D2 --> D4
        D4 --> D5
        D4 --> D6
        D4 --> D7
        D4 --> D8
    end

    L3 --> E(["fa:fa-check-circle Adjusted Finding + Risk Score"])

    style L1 fill:#1e40af,color:#fff
    style L2 fill:#1e40af,color:#fff
    style L3 fill:#1e40af,color:#fff
