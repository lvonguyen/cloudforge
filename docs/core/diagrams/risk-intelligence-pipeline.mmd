        D1 -->|conf >= 0.70| D2
        D1 -->|conf < 0.70| D3
        D2 --> D4
        D4 --> D5
        D4 --> D6
        D4 --> D7
    end

    L3 --> E([Adjusted Finding + Risk Score])

