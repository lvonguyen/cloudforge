# Cloud Aegis Frontend Environment Variables
# Copy to .env.development for local development

VITE_API_URL=http://localhost:8080
VITE_OKTA_ISSUER=https://your-org.okta.com/oauth2/default
VITE_OKTA_CLIENT_ID=your-client-id
VITE_DEV_TOKEN=

# Branding (override for whitelabel deployments)
VITE_COMPANY_NAME=Contoso
VITE_PRODUCT_NAME=Cloud Aegis
VITE_LOGO_PATH=/icons/aegis-logo.svg
VITE_EMAIL_DOMAIN=contoso.dev
VITE_REPO_PREFIX=github.com/contoso

# Module visibility (comma-separated slugs)
VITE_ENABLED_MODULES=aegis,cspm-aggregator

# Storage key prefix (prevents localStorage collisions between tenants)
VITE_STORAGE_PREFIX=aegis

# Theme colors (CSS hex, empty = use defaults from index.css)
VITE_BRAND_PRIMARY=
VITE_BRAND_SECONDARY=
VITE_BRAND_ACCENT=

# Demo viewer access (landing page shows credentials + SSO button)
VITE_DEMO_ACCESS_ENABLED=false
VITE_DEMO_VIEWER_EMAIL=
VITE_DEMO_VIEWER_PASSWORD=

# Per-tenant builds: vite build --mode haea
# See .env.haea and .env.contoso for examples
