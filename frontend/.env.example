# CloudForge Frontend Environment Variables
# Copy to .env.development for local development

VITE_API_URL=http://localhost:8080
VITE_OKTA_ISSUER=https://your-org.okta.com/oauth2/default
VITE_OKTA_CLIENT_ID=your-client-id
VITE_DEV_TOKEN=

# Branding (override for whitelabel deployments)
VITE_COMPANY_NAME=Contoso
VITE_PRODUCT_NAME=CloudForge
VITE_LOGO_PATH=/icons/cloudforge-logo.svg
VITE_EMAIL_DOMAIN=contoso.dev
VITE_REPO_PREFIX=github.com/contoso
